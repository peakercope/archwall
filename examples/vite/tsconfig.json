{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" for archwall.config.ts / vite.config.ts; "vite/client" for `import "./styles.css"`.
    "types": ["node", "vite/client"],
    "declaration": false,
    "noEmit": true,
    // ArchWall's CLI reads these `paths` to resolve `@/…` specifiers. Vite does NOT —
    // it needs the same alias declared in `resolve.alias`. See vite.config.ts.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "archwall.config.ts"]
}
