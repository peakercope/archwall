{
  "name": "@archwall/test-utils",
  "version": "0.2.0",
  "description": "Fixture graph builders and violation assertions for testing ArchWall rules, presets, and classifiers.",
  "keywords": [
    "archwall",
    "testing",
    "architecture",
    "dependency-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakercope/archwall.git",
    "directory": "packages/test-utils"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "dependencies": {
    "@archwall/core": "workspace:^"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
