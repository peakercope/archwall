{
  "name": "@archwall/presets",
  "version": "1.0.0",
  "description": "Built-in architecture presets for ArchWall: Feature-Sliced Design, layered (Clean/Onion/Hexagonal), and independent modules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakercope/archwall.git",
    "directory": "packages/presets"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "dependencies": {
    "@archwall/rules": "^1.0.0"
  },
  "peerDependencies": {
    "@archwall/core": "^1.0.0"
  },
  "devDependencies": {
    "@archwall/core": "^1.0.0",
    "@archwall/test-utils": "^1.0.0"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
