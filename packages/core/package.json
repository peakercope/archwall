{
  "name": "@archwall/core",
  "version": "0.0.0",
  "description": "Graph IR, analysis engine, and rule/preset/reporter contracts for ArchWall.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakercope/archwall.git",
    "directory": "packages/core"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "internal": [
        "./dist/internal.d.cts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./internal": {
        "import": "./dist/internal.mjs",
        "require": "./dist/internal.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
