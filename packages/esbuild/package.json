{
  "name": "@archwall/esbuild",
  "version": "0.2.1",
  "description": "esbuild adapter for ArchWall: builds the project graph from the build's metafile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakercope/archwall.git",
    "directory": "packages/esbuild"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "dependencies": {
    "@archwall/integration-kit": "^0.2.1"
  },
  "peerDependencies": {
    "esbuild": "^0.25.0 || ^0.28.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@archwall/core": "^0.2.1",
    "@archwall/presets": "^0.2.1",
    "@archwall/rules": "^0.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
